#!/bin/sh
set -eu

state_dir=/var/lib/snapd/boot-from-seed-poc
snap_dir=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
run_system=${POC_RUN_SYSTEM:-$(cat /run/snapd/booted-run-seed 2>/dev/null || printf unknown)}
mkdir -p "$state_dir"
printf '%s %s\n' "$run_system" "$(cat "$snap_dir/poc-revision")" \
    > "$state_dir/active-service"
exec sleep infinity